# LLM provider: echo (offline deterministic) | gemini | openai-compat
LLM_PROVIDER=echo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Storage backend: sqlite (default, persistent file) | memory (tests only)
STORE_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/events.db

# Security
FRONTEND_ORIGIN=http://localhost:8000
RATE_LIMIT_PER_MIN=200
MAX_UPLOAD_BYTES=10485760
MAX_STORE_EVENTS=5000
DEMO_MODE=true

# App
PORT=8000
LOG_LEVEL=info
